<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/wp_accent_a12" />
            <corners android:radius="@dimen/wp_radius_chip" />
            <stroke android:width="1dp" android:color="@color/wp_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wp_bg3" />
            <corners android:radius="@dimen/wp_radius_chip" />
            <stroke android:width="1dp" android:color="@color/wp_line" />
        </shape>
    </item>
</selector>
