<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/wp_accent" />
                    <size android:width="20dp" android:height="20dp" />
                </shape>
            </item>
            <item
                android:top="5dp"
                android:bottom="5dp"
                android:start="5dp"
                android:end="5dp">
                <shape android:shape="oval">
                    <solid android:color="@color/wp_accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="@color/wp_disabled" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
</selector>
