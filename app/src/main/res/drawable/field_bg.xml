<?xml version="1.0" encoding="utf-8"?>
<!-- Focused search field: bg2 fill, accent border, 3dp accent-12% focus ring -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wp_accent_a12" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item
        android:top="3dp"
        android:bottom="3dp"
        android:start="3dp"
        android:end="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/wp_bg2" />
            <corners android:radius="@dimen/wp_radius_field" />
            <stroke android:width="1dp" android:color="@color/wp_accent" />
        </shape>
    </item>
</layer-list>
