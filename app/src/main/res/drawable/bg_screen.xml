<?xml version="1.0" encoding="utf-8"?>
<!-- Tinted screen background: bg0 + violet radial top-left + gold radial right (PRD §2.4) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wp_bg0" />
        </shape>
    </item>
    <item android:top="-220dp" android:start="-180dp" android:end="60dp" android:bottom="200dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:startColor="#2E7C6CF2"
                android:endColor="#007C6CF2" />
        </shape>
    </item>
    <item android:top="60dp" android:start="180dp" android:end="-200dp" android:bottom="140dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:startColor="#1AFFB020"
                android:endColor="#00FFB020" />
        </shape>
    </item>
</layer-list>
