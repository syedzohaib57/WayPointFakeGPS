<?xml version="1.0" encoding="utf-8"?>
<!-- 72dp tinted disc behind the floating 3D icon on the active setup step -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="36dp"
        android:centerY="0.4"
        android:startColor="#3D7C6CF2"
        android:endColor="#0A7C6CF2" />
    <stroke android:width="1dp" android:color="@color/wp_accent_a28" />
</shape>
