<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="34dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/sheet_handle" />

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/inter_semibold"
        android:text="@string/fav_rename"
        android:textColor="@color/wp_text_hi"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/fav_name_label"
        android:textColor="@color/wp_text_mid"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/field_bg"
        android:gravity="center_vertical"
        android:paddingStart="17dp"
        android:paddingEnd="17dp">

        <EditText
            android:id="@+id/nameField"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:textColor="@color/wp_text_hi"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/saveBtn"
        style="@style/Wp.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/wp_h_button_mid"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_accent"
        android:drawablePadding="8dp"
        android:text="@string/fav_save"
        android:textColor="@color/wp_on_accent" />
</LinearLayout>
