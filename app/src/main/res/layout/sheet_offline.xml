<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="34dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/inter_semibold"
        android:text="@string/row_offline"
        android:textColor="@color/wp_text_hi"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/offlineSummary"
        style="@style/Wp.Mono.Readout13"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/wp_text_mid"
        tools:text="48 MB · 1,284 tiles · Lahore z11–z15" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.5"
        android:text="@string/offline_body"
        android:textColor="@color/wp_text_mid"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/clearBtn"
            style="@style/Wp.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/wp_h_button_mid"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost_outline"
            android:text="@string/offline_clear"
            android:textColor="@color/wp_text_mid" />

        <TextView
            android:id="@+id/downloadBtn"
            style="@style/Wp.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/wp_h_button_mid"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/btn_accent"
            android:text="@string/offline_download"
            android:textColor="@color/wp_on_accent" />
    </LinearLayout>
</LinearLayout>
