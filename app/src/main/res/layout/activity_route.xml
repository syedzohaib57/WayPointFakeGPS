<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/routeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/wp_h_appbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <FrameLayout
            android:id="@+id/backBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/row_press_rounded"
            android:contentDescription="@string/cd_back">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/wp_text_hi" />
        </FrameLayout>

        <TextView
            style="@style/Wp.Text.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/route_title" />

        <FrameLayout
            android:id="@+id/menuBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/row_press_rounded"
            android:contentDescription="@string/cd_route_menu">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/wp_text_mid" />
        </FrameLayout>

        <TextView
            android:id="@+id/saveBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/row_press_rounded"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/route_save"
            android:textColor="@color/wp_accent"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/routeMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <app.waypoint.ui.route.RouteOverlayView
            android:id="@+id/routeOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/liveChip"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/gold_chip"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <app.waypoint.ui.widgets.LiveDotView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:letterSpacing="0.12"
                android:text="@string/mocking_active"
                android:textColor="@color/wp_on_live"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/livePct"
                style="@style/Wp.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/dm_mono_medium"
                android:textColor="@color/wp_on_live"
                android:textSize="12sp"
                tools:text="42%" />
        </LinearLayout>

        <TextView
            android:id="@+id/tapHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/pill_label_bg"
            android:elevation="6dp"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/route_hint_tap"
            android:textColor="@color/wp_text_mid"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/routeAttribution"
            style="@style/Wp.Mono.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/attribution_bg"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:textColor="#3B4A5A"
            android:textSize="9sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/wp_bg1"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/routeSummary"
            style="@style/Wp.Mono.Readout13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="4 points · 3.4 km · ~5 min" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="@string/route_speed"
                android:textColor="@color/wp_text_mid"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/speedSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:max="23"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:progressDrawable="@drawable/seek_track"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb" />

            <TextView
                android:id="@+id/speedValue"
                style="@style/Wp.Mono.Value"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/wp_text_hi"
                tools:text="40 km/h" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/loopChip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/wp_h_chip"
                android:background="@drawable/chip_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/loopIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_repeat"
                    app:tint="@color/wp_text_mid" />

                <TextView
                    android:id="@+id/loopLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="@string/route_loop"
                    android:textColor="@color/wp_text_mid"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reverseChip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/wp_h_chip"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/reverseIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_swap_horiz"
                    app:tint="@color/wp_text_mid" />

                <TextView
                    android:id="@+id/reverseLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="@string/route_reverse"
                    android:textColor="@color/wp_text_mid"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playBtn"
            style="@style/Wp.Btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/wp_h_button"
            android:layout_marginTop="14dp"
            app:icon="@drawable/ic_play_arrow_fill"
            android:text="@string/route_play" />
    </LinearLayout>
</LinearLayout>
