<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="34dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/sheet_handle" />

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/wp_text_hi"
        android:textSize="18sp"
        tools:text="Intent API" />

    <TextView
        android:id="@+id/autoBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.5"
        android:textColor="@color/wp_text_mid"
        android:textSize="15sp"
        tools:text="Any app — or an adb shell — can drive Waypoint with broadcast intents." />

    <TextView
        android:id="@+id/autoExample"
        style="@style/Wp.Mono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_code"
        android:lineSpacingMultiplier="1.6"
        android:padding="14dp"
        android:textColor="@color/wp_accent2"
        android:textSize="12sp"
        tools:text="am broadcast -a app.waypoint.SET" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Wp.Text.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/external_control_title" />

            <TextView
                style="@style/Wp.Text.RowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/external_control_sub" />
        </LinearLayout>

        <app.waypoint.ui.widgets.WpToggle
            android:id="@+id/externalToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/copyBtn"
        style="@style/Wp.Btn.Outline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/wp_h_button_mid"
        android:layout_marginTop="14dp"
        app:icon="@drawable/ic_content_copy"
        android:text="@string/copy_example" />
</LinearLayout>
