<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stepRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="8dp"
    android:paddingEnd="0dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/badge"
        style="@style/Wp.Mono"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/badge_idle"
        android:gravity="center"
        android:textColor="@color/wp_text_low"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/wp_text_low"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/stepBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.5"
            android:textColor="@color/wp_text_mid"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/checkLines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/stepHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/wp_live"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stepButton"
            style="@style/Wp.Btn.Outline"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:minWidth="190dp"
            android:maxWidth="250dp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/iconDisc"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/setup_disc"
        android:visibility="gone">

        <ImageView
            android:id="@+id/icon3d"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />
    </FrameLayout>
</LinearLayout>
