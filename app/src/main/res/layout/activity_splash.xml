<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <View
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_marginStart="-120dp"
        android:layout_marginTop="-120dp"
        android:background="@drawable/splash_glow_white"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-140dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/splash_glow_gold"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="270dp"
            android:layout_height="270dp">

            <app.waypoint.ui.widgets.RadarView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <FrameLayout
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center"
                android:background="@drawable/splash_tile"
                android:elevation="16dp">

                <ImageView
                    android:id="@+id/satellite"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/wp3d_satellite" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/wordmark"
            style="@style/Wp.Text.Wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_medium"
            android:text="@string/splash_sub"
            android:textColor="@color/wp_white_78"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <app.waypoint.ui.widgets.RingView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:ringColor="@android:color/white"
            app:ringTrackColor="@color/wp_white_25"
            app:ringStroke="2dp"
            app:ringIndeterminate="true" />

        <TextView
            android:id="@+id/statusLine"
            style="@style/Wp.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/wp_white_80"
            android:textSize="12sp"
            tools:text="Checking mock provider…" />
    </LinearLayout>
</FrameLayout>
