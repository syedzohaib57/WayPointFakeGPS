<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/wp_h_chip"
    android:layout_marginEnd="8dp"
    android:background="@drawable/glass_chip"
    android:elevation="6dp"
    android:foreground="@drawable/row_press_rounded"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="12dp">

    <View
        android:id="@+id/chipDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/dot" />

    <TextView
        android:id="@+id/chipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/inter_medium"
        android:maxLines="1"
        android:textColor="@color/wp_text_hi"
        android:textSize="13sp"
        tools:text="Office — Gulberg" />
</LinearLayout>
