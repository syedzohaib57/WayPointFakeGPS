<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row_press"
    android:gravity="center_vertical"
    android:minHeight="@dimen/wp_h_row"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="@dimen/wp_icon_tile"
        android:layout_height="@dimen/wp_icon_tile"
        android:background="@drawable/icon_tile">

        <ImageView
            android:id="@+id/rowIcon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            app:tint="@color/wp_accent_lt"
            tools:src="@drawable/ic_my_location" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            style="@style/Wp.Text.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Accuracy" />

        <TextView
            android:id="@+id/rowSub"
            style="@style/Wp.Text.RowSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone"
            tools:text="48 MB cached" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowValue"
        style="@style/Wp.Mono.Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:visibility="gone"
        tools:text="5 m" />

    <app.waypoint.ui.widgets.WpToggle
        android:id="@+id/rowToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="@color/wp_text_low" />
</LinearLayout>
