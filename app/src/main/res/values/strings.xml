    <string name="tasker_body">Waypoint registers as a Tasker action plugin. Set, move or stop the mock from any profile.</string>
    <string name="intent_body">Any app — or an adb shell — can drive Waypoint with broadcast intents.</string>
    <string name="intent_example">am broadcast -a app.waypoint.SET \\\n  --ef lat 31.5204 --ef lon 74.3587 --ei acc 5\nam broadcast -a app.waypoint.STOP</string>
